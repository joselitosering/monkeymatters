{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shadow Monkey Trade Outcome Record",
  "type": "object",
  "required": ["date","results"],
  "properties": {
    "date":      { "type": "string", "format": "date" },
    "graded_at": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","symbol","result","triggered"],
        "properties": {
          "id":          { "type": "string" },
          "symbol":      { "type": "string" },
          "result":      { "type": "string",
            "enum": ["win","loss","scratch","no_trigger","open","indeterminate","no_data","ungradable"] },
          "triggered":   { "type": "boolean" },
          "r_multiple":  { "type": ["number","null"] },
          "exit_reason": { "type": "string",
            "enum": ["target","stop","time","manual","indeterminate","n/a","no_data"] },
          "exit_bar":    { "type": ["integer","null"] },
          "notes":       { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
