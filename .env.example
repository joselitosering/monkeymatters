
# PRIMARY MARKET DATA — Schwab Trader API (best fidelity: minute bars,
# real option chains, movers, quotes). OAuth refresh token expires every
# 7 days — the Schwab leg runs on THIS machine (weekly 60-sec re-login),
# never headless in GitHub Actions.
# Get: https://developer.schwab.com (create app -> Market Data Production)
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# set after first OAuth login by the setup script; auto-managed thereafter
SCHWAB_TOKEN_PATH=.secrets/schwab_token.json
